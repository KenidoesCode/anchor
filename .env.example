# Copy to .env for local development. NEVER commit a real value.
# The app refuses to start in production mode with the built-in dev key.

# --- Required ---
# Postgres connection string. Local demo uses docker-compose's db service.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/greensafe

# Field-encryption key for national identifiers. REQUIRED in production.
# DEMO ONLY here — production must use a real key from AWS KMS (not this).
# Generate: openssl rand -base64 32
GS_DATA_KEY=dev-insecure-key-do-not-ship

# Session signing secret. REQUIRED in production. Generate: openssl rand -base64 32
GS_SESSION_SECRET=dev-session-secret

# --- Optional ---
# Persistent "Demonstration environment" banner. Set to "off" to hide.
GS_DEMO_BANNER=on

# Certificate document storage: "local" (default, filesystem) or "s3".
# s3 is unused without AWS credentials and throws clearly if selected.
STORAGE_ADAPTER=local
# Where the local adapter writes uploads (default ./.uploads).
GS_UPLOAD_DIR=.uploads

# Notification channels. Console is the default (nothing is sent). Set to "stub"
# to route email/SMS to the stub adapters, which throw (no provider is wired).
# GS_NOTIFY_EMAIL=stub
# GS_NOTIFY_SMS=stub

# NODE_ENV: development | production. Production triggers the boot guard.
# NODE_ENV=development
